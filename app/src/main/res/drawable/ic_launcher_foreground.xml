                android:type="linear">
                <item android:color="#00E676" android:offset="0.0" />
                <item android:color="#00B0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sync Arrow Accents -->
    <path
        android:pathData="M34,54 L26,54 M82,54 L74,54 M54,34 L54,26 M54,82 L54,74"
