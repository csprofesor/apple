        android:strokeColor="#00E676"
        android:strokeAlpha="0.4"/>

    <path
        android:pathData="M54,26 A28,28 0 1 1 53.99,26 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#00B0FF"
        android:strokeAlpha="0.6"/>

    <!-- Central Glowing Play Diamond/Triangle -->
    <path
        android:pathData="M44,36 L72,54 L44,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="36"
                android:endX="72"
