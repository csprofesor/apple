<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PlayRepo Publisher"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Film sitesini taratın ve tek tıkla Nuvio eklentinize yükleyin"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

        <!-- Target Site / Catalog URL -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Film Sitesi Adresi"
            app:boxStrokeColor="#00E676"
            app:hintTextColor="#00E676">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSiteUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:text="https://www.hintfilmizle.com/film-izle/"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Max Pages Limit -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Tarama Sayfa Limiti"
            app:boxStrokeColor="#00E676"
            app:hintTextColor="#00E676">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMaxPages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="30"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- TMDB API Key (Optional) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="TMDB API Key (Opsiyonel)"
            app:boxStrokeColor="#00E676"
            app:hintTextColor="#00E676">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTmdbApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Main Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrawlSite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2979FF"
            android:padding="12dp"
            android:text="1. Tüm Siteyi Tara ve Video Linklerini Çöz"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishBatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#00E676"
            android:enabled="false"
            android:padding="12dp"
            android:text="2. GitHub'a Yükle (Nuvio Eklentisine Gönder)"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Output Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="İşlem Durumu:"
            android:textColor="#B0BEC5"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E1E1E"
            android:padding="14dp"
            android:text="Hazır. Sitemizi taratmak için 1. butona basın."
            android:textColor="#00E676"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
