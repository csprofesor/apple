<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PlayRepo Auto Publisher"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kayıtlı tüm film sitelerini tek tıkla tarayıp Nuvio eklentinize yükleyin"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

        <!-- 1-Click Master Update Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateAllSites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#00E676"
            android:padding="14dp"
            android:text="🚀 TÜM SİTELERİ GÜNCELLE VE GİTHUB'A YÜKLE"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Kayıtlı Film Siteleri:"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Site Add Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Yeni Site Adresi Ekle"
                app:boxStrokeColor="#2979FF"
                app:hintTextColor="#2979FF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNewSiteUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddSite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2979FF"
                android:text="Site Ekle"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Saved Sites TextView / Container -->
        <TextView
            android:id="@+id/tvSavedSites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:text="Kayıtlı site yok."
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <!-- Max Pages Limit -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Site Başına Tarama Sayfa Limiti"
            app:boxStrokeColor="#00E676"
            app:hintTextColor="#00E676">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMaxPages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="15"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- TMDB API Key (Optional) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="TMDB API Key (Opsiyonel)"
            app:boxStrokeColor="#00E676"
            app:hintTextColor="#00E676">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTmdbApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Output Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="İşlem Durumu ve Canlı Çıktı:"
            android:textColor="#B0BEC5"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E1E1E"
            android:padding="14dp"
            android:text="Hazır. Tüm siteleri güncellemek için en üstteki yeşil butona basın."
            android:textColor="#00E676"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
