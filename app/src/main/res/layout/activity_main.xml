<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Page Content Container -->
    <FrameLayout
        android:id="@+id/containerPage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pageDashboard"
            layout="@layout/page_dashboard"
            android:visibility="visible" />

        <include
            android:id="@+id/pageSites"
            layout="@layout/page_sites"
            android:visibility="gone" />

        <include
            android:id="@+id/pageSingle"
            layout="@layout/page_single"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#090D16"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemRippleColor="#1E293B"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
