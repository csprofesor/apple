<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PlayRepo Site Crawler &amp; Publisher"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Film sitesindeki tüm filmleri tarayıp Nuvio eklentisine aktarın"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

        <!-- Target Site / Catalog URL -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Film Sitesi Adresi (Örn: https://www.hintfilmizle.com/film-izle/)"
            app:boxStrokeColor="#00E676"
            app:hintTextColor="#00E676">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSiteUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:text="https://www.hintfilmizle.com/film-izle/"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- TMDB API Key -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="TMDB API Key (Opsiyonel - Otomatik ID bulma için)"
            app:boxStrokeColor="#00E676"
            app:hintTextColor="#00E676">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTmdbApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- GitHub Personal Access Token -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="GitHub Personal Access Token (PAT)"
            app:boxStrokeColor="#00E676"
            app:hintTextColor="#00E676">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGithubToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrawlSite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#2979FF"
            android:text="1. Tüm Siteyi Tara (Filmleri Bul)"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishBatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#00E676"
            android:enabled="false"
            android:text="2. Tüm Filmleri GitHub'a Yükle (Nuvio'ya Gönder)"
            android:textColor="#000000"
            android:textSize="16sp" />

        <!-- Output Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="İşlem Durumu ve Çıktı:"
            android:textColor="#B0BEC5"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:text="Henüz işlem yapılmadı."
            android:textColor="#00E676"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
